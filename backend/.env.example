# RotoMart backend env — copy to .env and fill in. Never commit the real .env.
# PORT is provided by the host in production (Render); locally defaults to 4000.
PORT=4000
# The deployed frontend origin — used for CORS, Paystack callback, and email links
FRONTEND_URL=http://localhost:5173
# Google Sheets service account (share the sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=          # keep the \n escapes; the code un-escapes them
GOOGLE_SHEET_ID=
# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Paystack (test keys for now; swap to client's live keys at go-live — see CLAUDE.md §6/§10)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ADMIN_SUBACCOUNT_CODE=
# Admin auth
JWT_SECRET=                 # long random string; rotate for production
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=        # node -e "console.log(require('bcryptjs').hashSync('PASSWORD',10))"
# Brevo (transactional email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional: low-stock alert trigger (default 5)
LOW_STOCK_THRESHOLD=5
